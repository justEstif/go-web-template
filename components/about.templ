package components

templ About() {
	@Layout("About") {
		<div class="prose lg:prose-xl mx-auto">
			<h1>About This Template</h1>
			<p>This is a modern Go web application template featuring:</p>
			<ul>
				<li><strong>Chi</strong> - Lightweight, idiomatic router</li>
				<li><strong>Templ</strong> - Type-safe Go templates</li>
				<li><strong>Tailwind CSS v4</strong> - Next-gen utility-first CSS</li>
				<li><strong>DaisyUI v5</strong> - Beautiful component library</li>
				<li><strong>HTMX</strong> - Modern interactivity without JavaScript frameworks</li>
				<li><strong>PostgreSQL</strong> - Reliable, powerful database</li>
				<li><strong>sqlc</strong> - Compile-time type-safe SQL queries</li>
				<li><strong>golang-migrate</strong> - Database migration management</li>
			</ul>
			<h2>Why This Stack?</h2>
			<p>This combination provides a productive, type-safe development experience with minimal JavaScript and maximum performance.</p>
		</div>
	}
}
